# Copiar a .env y ajustar. En dev los defaults del compose ya alcanzan.

# ----- HTTP / debug (host) -----
APP_PORT=8082
DEBUG_PORT=5006

# ----- Perfil Quarkus -----
QUARKUS_PROFILE=dev

# ----- PostgreSQL (debe coincidir con ../itilsupport/Postgres/.env) -----
DB_NAME=itilsupport
DB_USER=itil
DB_PASSWORD=itil
# create-drop | drop-and-create | update | validate | none
DB_DDL=update

# ----- Keycloak / OIDC (cuando se agregue quarkus-oidc) -----
OIDC_REALM=cooponboard
OIDC_CLIENT_ID=cooponboard
OIDC_CLIENT_SECRET=change-me

# ----- Vault (cuando se agregue quarkus-vault) -----
VAULT_USERNAME=helpdesk-reader
VAULT_PASSWORD=R3ad3r_S3cur3!2026

# ----- MinIO (cuando se agregue quarkus-minio) -----
MINIO_ACCESS_KEY=minioadmin
MINIO_SECRET_KEY=minioadmin123
