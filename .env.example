# Copiar a .env y ajustar. El .env NO se versiona (ver .gitignore).

# ----- HTTP / debug (host) -----
APP_PORT=8090
DEBUG_PORT=5006

# ----- Perfil Quarkus -----
QUARKUS_PROFILE=dev

# ----- PostgreSQL -----
# Solo nombre/DDL: las CREDENCIALES (user/pass) viven en Vault.
DB_NAME=cooponboard
# create-drop | drop-and-create | update | validate | none
DB_DDL=update

# ----- Vault (credencial de la APP para leer secretos) -----
# Usuario userpass con politica de solo-lectura sobre dev/cooponboard/*.
VAULT_USERNAME=cooponboard-app
# Pega aqui el password real del usuario 'cooponboard-app' (NO lo subas al repo).
VAULT_PASSWORD=

# ----- Keycloak / OIDC -----
# Realm = ambiente. cooponboard-api = client resource server (audience).
OIDC_REALM=internos-dev
OIDC_CLIENT_ID=cooponboard-api

# ----- Docker Network Config -----
# Nombre de la red externa compartida de Docker.
# Por defecto se usa 'itilsupport_network_dev', pero puedes cambiarlo a tu propia red.
DOCKER_NETWORK=itilsupport_network_dev
