# Copiar a .env y ajustar. El .env NO se versiona (ver .gitignore).

# ----- HTTP / debug (host) -----
APP_PORT=8082
DEBUG_PORT=5006

# ----- Perfil Quarkus -----
QUARKUS_PROFILE=dev

# ----- PostgreSQL -----
# Solo nombre/DDL: las CREDENCIALES (user/pass) viven en Vault.
DB_NAME=itilsupport
# create-drop | drop-and-create | update | validate | none
DB_DDL=update

# ----- Vault (credencial de la APP para leer secretos) -----
# Usuario userpass con politica de solo-lectura sobre dev/cooponboard/*.
VAULT_USERNAME=cooponboard
# Pega aqui el password real del usuario 'cooponboard' (NO lo subas al repo).
VAULT_PASSWORD=

# ----- Keycloak / OIDC -----
OIDC_REALM=cooponboard
OIDC_CLIENT_ID=cooponboard
